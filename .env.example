# -----------------------------------------------------------------------------
# Deslop — Environment Configuration
# -----------------------------------------------------------------------------

# Zorveus AI Gateway Configuration
# Get your inference and service keys from https://dash.zorveus.com
ZORVEUS_INFERENCE_KEY=zrv_your_default_inference_key_here

# Plan-Specific Inference Keys (API-key-level policy routing)
# Free Plan Key (Policy: limit_output, $2/user/month allowance, basic models)
ZORVEUS_FREE_KEY=zrv_free_key_here

# Pro Plan Key (Policy: allow_overrun, $25/user/month allowance, pro models)
ZORVEUS_PRO_KEY=zrv_pro_key_here

# Zorveus Organization Service Key (For server-side credit grants and product-user management)
# WARNING: Keep server-side only. Never expose to client bundles.
ZORVEUS_SERVICE_KEY=zrv_service_key_here

# Optional: Zorveus Application ID
ZORVEUS_APP_ID=app_your_deslop_app_id

# Model to route inference to (default: zorveus/gpt-oss-120b)
ZORVEUS_MODEL=zorveus/gpt-oss-120b

# Zorveus URLs (defaults to production if unset)
ZORVEUS_GATEWAY_URL=https://api.zorveus.com/v1
ZORVEUS_BASE_URL=https://api.zorveus.com

# Optional: Upstash Redis (For persistent production rate-limiting across serverless instances)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Stripe Billing (If you decide to charge a flat base subscription fee for Pro)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
