{
  "name": "deslop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@deslop/web",
    "dev:api": "npm run dev --workspace=@deslop/api",
    "build:web": "npm run build --workspace=@deslop/web",
    "build:api": "npm run build --workspace=@deslop/api",
    "build": "npm run build:api && npm run build:web",
    "start:web": "npm run start --workspace=@deslop/web",
    "start:api": "npm run start --workspace=@deslop/api",
    "lint": "npm run lint --workspace=@deslop/web",
    "test:swagger": "tsx scripts/test-swagger.ts",
    "test:synthesis": "tsx scripts/test-token-synthesis.ts",
    "test": "npm run test:swagger && npm run test:synthesis"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
