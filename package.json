{
  "name": "deslop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm run dev --workspace=@deslop/api",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:synthesis": "node --experimental-strip-types scripts/test-token-synthesis.ts",
    "test": "node scripts/test-zorveus.mjs && node --experimental-strip-types scripts/test-pipeline.mjs && node --experimental-strip-types scripts/test-token-synthesis.ts && node --experimental-strip-types scripts/test-design-md.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@zorveus/sdk": "^0.3.1",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
